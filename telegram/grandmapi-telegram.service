[Unit]
Description=grandmapi Telegram Bot
After=network-online.target
Wants=network-online.target
# Never stop retrying, no matter how many times it crashes
StartLimitIntervalSec=0

[Service]
User=admin
EnvironmentFile=/etc/grandmapi.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/admin/grandmapi
ExecStart=/usr/bin/python3 /home/admin/grandmapi/telegram/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
